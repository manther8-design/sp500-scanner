# Database — use Postgres in Docker; SQLite works for local smoke tests
DATABASE_URL=postgresql+psycopg://scanner:scanner@localhost:5432/scanner
# DATABASE_URL=sqlite:///./scanner.db

REDIS_URL=redis://localhost:6379/0

# Telegram (optional — leave empty to disable outbound alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scan defaults
SCAN_INTERVAL_MINUTES=60
DATA_PROVIDER=yfinance

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Web — leave empty to use Next.js proxy (recommended for local Windows)
# NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://127.0.0.1:8000
